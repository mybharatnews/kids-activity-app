{
  "name": "kids-activity-app",
  "version": "1.0.2",
  "description": "Std 7 English Learning App for Dravy — Learn, Practice, Play!",
  "author": "Dravy's Dad",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.dravy.englishapp",
    "productName": "Dravy's English App",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dravy's English App"
    },
    "files": [
      "main.js",
      "app.html",
      "index.html",
      "data.js",
      "grammar-data.js",
      "grammar-data-part1.js",
      "grammar-data-part2.js",
      "study-notes-data.js",
      "icon.png",
      "package.json"
    ]
  }
}
